# Wrapture Frontend — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# URL of the Flask backend (no trailing slash)
REACT_APP_API_URL=http://localhost:5000

# Google Maps JavaScript API key — required for the Recycling Center Locator.
# 1. Go to https://console.cloud.google.com/
# 2. Enable: Maps JavaScript API, Places API (New)
# 3. Create an API key and restrict it to your domain.
# 4. Paste the key below (never commit the real key).
REACT_APP_GOOGLE_MAPS_API_KEY=

GENERATE_SOURCEMAP=false
DISABLE_ESLINT_PLUGIN=false
