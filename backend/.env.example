# Wrapture Backend — environment variables
# Copy this file to backend/.env and fill in your values.
# Never commit backend/.env to version control.

# ── LLM (TrashGPT) ────────────────────────────────────────────────────────────
# Set LLM_PROVIDER=openai and provide your OpenAI API key to enable TrashGPT.
# If LLM_API_KEY is empty, the chatbot returns a clear "not configured" message.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# ── Google Maps Platform ──────────────────────────────────────────────────────
# Required for the Recycling Center Locator (ReverseLogistics page).
# Enable Maps JavaScript API + Places API (New) in Google Cloud Console.
# Restrict the key to your server IP in production.
GOOGLE_MAPS_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000
