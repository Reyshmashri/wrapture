{
  "appId": "com.wrapture.app",
  "appName": "Wrapture",
  "webDir": "build",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "http",
    "hostname": "localhost:3000",
    "cleartext": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#183325",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#183325"
    }
  }
}
